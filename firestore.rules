rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is administrator
    // In this CMS, only accounts created by the owner in the Firebase Console can authenticate
    function isAdmin() {
      return isAuthenticated();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Articles collection
    match /articles/{articleId} {
      // Public users can ONLY read published articles. Admins can read all articles (including drafts).
      allow read: if (resource.data.status == 'published') || isAdmin();
      // Only authenticated admin staff can create, edit, or delete articles
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscribers collection
    match /newsletterSubscribers/{subscriberId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

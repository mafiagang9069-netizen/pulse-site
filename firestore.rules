rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is authorized as administrator
    // Primary mechanism: Firebase Auth Custom Claims (request.auth.token.admin == true)
    // Fallback mechanism: verified admin role document in users collection
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow update, delete: if isAdmin();
    }

    // Articles collection
    match /articles/{articleId} {
      // Public users can only read published articles. Admins can read all articles (including drafts).
      allow read: if (resource.data.status == 'published') || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscribers collection
    match /newsletterSubscribers/{subscriberId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.matches('^.+@.+\\..+$');
      allow read, update, delete: if isAdmin();
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
